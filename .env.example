# ==============================================================================
# Shorts Cloner Agent - Environment Configuration
# ==============================================================================

# Gemini Vision & Language API Key (Get free key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (Default: gemini-3.0-flash, Fallback: gemini-2.5-flash)
GEMINI_MODEL=gemini-3.0-flash

# Default Edge-TTS Voice (Indonesian: id-ID-ArdiNeural / English: en-US-ChristopherNeural)
DEFAULT_VOICE=en-US-ChristopherNeural
DEFAULT_VOICE_RATE=+18%

# Subtitle & Audio Settings
WHISPER_MODEL=small
DEVICE=cuda
COMPUTE_TYPE=int8

# Video Encoding Settings
VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
FFMPEG_CODEC=h264_nvenc

# YouTube Data API v3 Auto-Upload & US High-RPM Scheduling
YOUTUBE_CLIENT_SECRETS_FILE=credentials/client_secrets.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
US_TARGET_TIMEZONE=America/New_York
US_PRIME_SLOTS_ET=08:00,12:30,16:30,20:00
YOUTUBE_UPLOAD_PRIVACY=scheduled
YOUTUBE_CATEGORY_ID=24
YOUTUBE_MADE_FOR_KIDS=false
